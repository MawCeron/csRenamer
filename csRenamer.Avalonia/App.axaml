<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:csRenamer.Avalonia.Converters"
             x:Class="csRenamer.Avalonia.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://csRenamer.Avalonia/Resources/Styles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://csRenamer.Avalonia/Resources/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanNegationConverter x:Key="NegateBool"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
